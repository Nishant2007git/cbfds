# ==========================================
# CBFDS - Production Environment Variables
# ==========================================

# ------------------------------------------
# Server Environment Variables (Render / Railway)
# ------------------------------------------
NODE_ENV=production
PORT=3000
API_VERSION=v1

# URLs (Set to your actual deployed domain URLs)
APP_URL=https://cbfds-api.onrender.com
FRONTEND_URL=https://cbfds-app.vercel.app

# MongoDB Atlas Database URI
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:securepassword@cluster0.mongodb.net/cbfds?retryWrites=true&w=majority
MONGODB_DB_NAME=cbfds

# Redis Cache & Queue (Upstash Redis or Render Redis)
REDIS_HOST=eu1-vocal-ant-38102.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_upstash_redis_password
# Optional alternative: REDIS_URL=rediss://default:password@host:6379

# Authentication (Generate a strong 32+ character random secret)
JWT_SECRET=super_secret_production_jwt_key_minimum_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Object Storage Configuration (AWS S3)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=cbfds-production-files
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1

# Transactional Email (Optional - SMTP / SendGrid)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@yourdomain.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@yourdomain.com

# System Limits & Quotas
MAX_FILE_SIZE=5368709120
DEFAULT_CHUNK_SIZE=5242880
DEFAULT_QUOTA=10737418240

# Logging & Rate Limiting
LOG_LEVEL=info
LOG_FORMAT=json
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------
# Client Environment Variables (Vercel / Render Static)
# ------------------------------------------
VITE_API_URL=https://cbfds-api.onrender.com/api/v1
